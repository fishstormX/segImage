# Optional. Copy to /etc/segImage/env on a server (root-owned, chmod 600; loaded by systemd EnvironmentFile),
# or export in your shell for local runs. Only OpenRouter models ending in ":free" are ever called.
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional settings
# SEGIMAGE_BASE_PATH=/segImage
# SEGIMAGE_MAX_BYTES=12582912
# SEGIMAGE_SERVE_UI=1

# per-IP rate limits for cutout calls; empty/0 disables
SEG_RATE_LIMITS=1/5s,6/60s
